# Copy to .env and fill in (never commit .env)

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Intake channel (public) where new clients message the bot
INTAKE_CHANNEL_ID=

# Category under which private client channels are created (optional)
CLIENT_CHANNELS_CATEGORY_ID=

# Freelancer/staff role (can run buat-prd, sees private channels)
STAFF_ROLE_ID=

# Role to @mention in jadwal-harian & reminder (falls back to STAFF_ROLE_ID)
FREELANCER_ROLE_ID=

# Scheduler channels (copy channel IDs from Discord)
JADWAL_HARIAN_CHANNEL_ID=
REMINDER_CHANNEL_ID=

# Daily schedule time (24h, server timezone below) — default 08:00
SCHEDULE_DAILY_AT=08:00
# Cron for reminders — default 09:00 & 15:00
SCHEDULE_REMINDER_CRON=0 9,15 * * *
SCHEDULE_TZ=Asia/Jakarta
# Remind when deadline is within N days (includes overdue)
REMINDER_DAYS_BEFORE=3

# Optional: notify when new client opens private channel
NOTIFICATIONS_CHANNEL_ID=

# QwenPaw / OpenAI-compatible API
QWENPAW_BASE_URL=
QWENPAW_API_KEY=
QWENPAW_MODEL=

# SQLite path (relative to project root)
DATABASE_PATH=./data/freewancer.sqlite
