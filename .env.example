# Copy to .env and fill in (never commit .env)

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Intake channel (public) where new clients message the bot
INTAKE_CHANNEL_ID=

# Category under which private client channels are created (optional)
CLIENT_CHANNELS_CATEGORY_ID=

# Mem9 to remember past sessions
MEM9_API_KEY=

# Optional: role that can see all client project channels
STAFF_ROLE_ID=

# QwenPaw / OpenAI-compatible API
QWENPAW_BASE_URL=
QWENPAW_API_KEY=
QWENPAW_MODEL=

# PostgreSQL (preferred: single URL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/freewancer

# Or discrete vars (used only if DATABASE_URL is unset)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=freewancer
# PGPASSWORD=
# PGDATABASE=freewancer
